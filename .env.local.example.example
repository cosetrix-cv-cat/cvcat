# Supabase Configuration
# Copia este archivo a .env.local y reemplaza los valores con tus credenciales

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANTE: Nunca expongas SUPABASE_SERVICE_ROLE_KEY en el cliente
# Solo usar credenciales de usuario anónimo o autenticadas